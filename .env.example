# Email notifications
RESEND_API_KEY=
CONTACT_RECIPIENT=idealailabs@gmail.com
CONTACT_FROM="IdealAI Labs <onboarding@resend.dev>"

# Admin dashboard
# Local demo default is demo-admin. Set this in production.
ADMIN_ACCESS_KEY=demo-admin

# Public base URL
APP_BASE_URL=https://idealailabs.com

# Durable store (libSQL via Drizzle). Local dev defaults to a SQLite file
# (.data/idealailabs.db) — no value needed. Production: a hosted Turso database.
DATABASE_URL=
# DATABASE_AUTH_TOKEN=        # required only for a hosted libsql:// Turso URL

# Thawani UAT/live checkout. The app also accepts the older aliases
# THAWANI_SECRET_KEY and THAWANI_PUBLIC_KEY.
THAWANI_API_KEY=
THAWANI_PUBLISHABLE_KEY=
THAWANI_BASE_URL=https://uatcheckout.thawani.om/api/v1
THAWANI_CHECKOUT_URL=https://uatcheckout.thawani.om/pay
THAWANI_WEBHOOK_SECRET=

# WhatsApp is intentionally web-simulated for these demos.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# WhatsApp Embedded Signup — real client onboarding (/onboard + /api/whatsapp/onboard).
# App ID + Config ID are public (sent to the browser); App Secret above is server-only.
NEXT_PUBLIC_WA_APP_ID=1666901441099073
NEXT_PUBLIC_WA_CONFIG_ID=          # the ES Configuration ID you created
WHATSAPP_GRAPH_VERSION=v23.0

# Optional document AI production mode
OPENAI_API_KEY=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
